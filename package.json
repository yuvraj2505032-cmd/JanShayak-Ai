    "test": "tsx --test frontend/src/utils/schemeEngine.test.ts frontend/src/utils/schemeSearch.test.ts frontend/src/lib/citizenCloudSync.test.ts frontend/src/lib/localAuth.test.ts backend/providers.test.ts backend/chatUtils.test.ts",
    "lint": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.118.0",
